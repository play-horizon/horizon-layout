{
	"name": "horizon-layout",
	"version": "1.0.2",
	"keywords": [
		"svelte"
	],
	"homepage": "https://play-horizon.github.io/horizon-layout",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/play-horizon/horizon-layout"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./horizon-layout.css": "./dist/horizon-layout.css"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint . && oxfmt --check .",
		"format": "oxfmt ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.6.2",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"publint": "^0.3.24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
