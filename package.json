{
	"name": "horizon-layout",
	"version": "1.0.5",
	"description": "A headless, fully keyboard-accessible docking layout for Svelte 5.",
	"keywords": [
		"docking",
		"drag-and-drop",
		"layout",
		"popout",
		"split-pane",
		"svelte",
		"svelte5",
		"tabs"
	],
	"homepage": "https://play-horizon.github.io/horizon-layout",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/play-horizon/horizon-layout"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./horizon-layout.css": "./dist/horizon-layout.css"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint . && oxfmt --check .",
		"test": "vitest run",
		"format": "oxfmt ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.6.6",
		"jsdom": "^31.0.1",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.2.0",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.17.0"
}
